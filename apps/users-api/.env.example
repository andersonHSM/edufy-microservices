# Configurações da aplicação
APP_NAME='Users API'
PORT=3003
NODE_ENV=development
API_PREFIX=api/v1

# Configurações do banco de dados PostgreSQL 17
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USERNAME=users_user
DATABASE_PASSWORD=users_password
DATABASE_NAME=users_db
DATABASE_SCHEMA=users
DATABASE_URL=postgresql://users_user:users_password@localhost:5433/users_db
DATABASE_SSL=false
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_CONNECTION_TIMEOUT=60000

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_USERS_QUEUE=users_queue
RABBITMQ_AUTH_QUEUE=auth_queue

# JWT (para validação de tokens do auth-service)
JWT_SECRET=your-super-secret-jwt-key
JWT_ISSUER=edufy-auth-service

# Redis - Cache e dados do usuário
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_TTL=3600
REDIS_KEY_PREFIX=users:

# Upload de arquivos
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf
UPLOAD_PATH=./uploads
UPLOAD_URL_PREFIX=/uploads
AWS_S3_BUCKET=your-s3-bucket
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Configurações de segurança
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Integração com Auth Service
AUTH_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_TIMEOUT=5000

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=20

# Logs
LOG_LEVEL=debug
LOG_FORMAT=json

# Health check
HEALTH_CHECK_DATABASE=true
HEALTH_CHECK_REDIS=true
HEALTH_CHECK_AUTH_SERVICE=true

# Notificações
NOTIFICATION_SERVICE_URL=http://localhost:3003
EMAIL_NOTIFICATION_ENABLED=false
